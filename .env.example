# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skavi?schema=public"
# Direct (non-pooled) connection for migrations. Neon's Vercel integration sets
# this automatically; without a connection pooler, use the same value as above.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/skavi?schema=public"
# 32+ random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=""
# Initial Super Admin created by `npm run db:seed`
SEED_SUPERADMIN_EMAIL="superadmin@example.com"
SEED_SUPERADMIN_PASSWORD=""
